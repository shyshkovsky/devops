# Caddy config for the Windows home server. Values come from environment
# variables set by start-all.ps1 (DOMAIN, SITE_ROOT).

(portfolio) {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Contact form -> contact service (more specific, matched before /api/*)
	handle /api/contact {
		request_body {
			max_size 16KB
		}
		reverse_proxy 127.0.0.1:8002
	}

	# Everything else under /api/ -> FastAPI backend (prefix stripped, like Nginx did)
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Static portfolio files
	handle {
		root * {$SITE_ROOT}
		try_files {path} /index.html
		file_server
	}
}

# Public site: Caddy gets and renews the Let's Encrypt certificate by itself
{$DOMAIN} {
	import portfolio
}

# Helpdesk ticket demo on its own port (HTTPS too)
{$DOMAIN}:8081 {
	request_body {
		max_size 16KB
	}
	reverse_proxy 127.0.0.1:8003
}

# Local-only test listeners: not opened in the firewall, usable before DNS cut-over
http://localhost:8088 {
	import portfolio
}
http://localhost:8089 {
	reverse_proxy 127.0.0.1:8003
}
