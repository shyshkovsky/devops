# Copy to .env (never commit .env)
TRUST_PROXY=1

# Telegram: create a bot with @BotFather, send it any message,
# then open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via Gmail: enable 2FA, then create an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=

RATE_LIMIT=5
RATE_WINDOW_SECONDS=3600
